# ==========================================
# Application Configuration
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# WebSocket Configuration
# ==========================================
# Secret token to authenticate Electron desktop clients
WS_AUTH_SECRET=secret_electron_handshake_token_12345
NEXT_PUBLIC_WS_AUTH_SECRET=secret_electron_handshake_token_12345
# Public WebSocket URL for client browser UI (defaults to current host /ws)
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws

# ==========================================
# Supabase Configuration
# ==========================================
# Retrieve these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Key (Backend only, never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
