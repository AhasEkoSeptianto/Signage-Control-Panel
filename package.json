{
  "name": "mjs-stack",
  "version": "0.1.0",
  "description": "SignageHub Player Desktop Client",
  "author": "SignageHub",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:next": "next dev",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "mock:electron": "tsx scripts/mock-electron.ts",
    "electron:dev": "node scripts/run-electron.js",
    "electron:build": "tsc --project tsconfig.electron.json",
    "electron:dist": "npm run electron:build && node scripts/copy-html.js && electron-builder --win",
    "lint": "next lint"
  },
  "build": {
    "appId": "com.signagehub.fleetplayer",
    "productName": "SignageHub Player",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
